# ==============================================================================
# Resto Platform - Unified Environment Configuration
# ==============================================================================

# Database (PostgreSQL 17)
POSTGRES_USER=resto_admin
POSTGRES_PASSWORD=resto_secure_password
POSTGRES_DB=restodb
DATABASE_URL=postgres://resto_admin:resto_secure_password@localhost:5432/restodb

# Redis (Cache, Pub/Sub & Geospatial)
REDIS_URL=redis://localhost:6379

# Security & JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
PUBLIC_ENC_KEY=encryption_key_for_sensitive_fields_32_chars
API_KEY=resto_internal_service_api_key

# API Gateway & Server
PORT=8080
API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_URL=http://localhost:5173

# Multi-Tenancy
ROOT_DOMAIN=resto.local

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=your_whatsapp_meta_cloud_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# Maps & Geolocation (For Driver Live Tracking)
MAP_TILES_PROVIDER=osm # osm | mapbox | maplibre
MAPBOX_ACCESS_TOKEN=pk.optional_mapbox_token_if_using_mapbox

# PgAdmin (Optional DB GUI)
PGADMIN_DEFAULT_EMAIL=admin@resto.local
PGADMIN_DEFAULT_PASSWORD=admin
